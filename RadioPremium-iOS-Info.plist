<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	ATS para AVPlayer en iOS. La mayoría de streams de Radio Browser API
	se sirven por HTTP plano (sin TLS). iOS bloquea HTTP por defecto.
	NSAllowsArbitraryLoadsForMedia abre la excepción SOLO para APIs de
	AVFoundation (AVPlayer, AVAsset). El resto de la app — incluidas las
	llamadas a Radio Browser API vía URLSession — sigue obligado a HTTPS,
	así que la superficie expuesta es mínima.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsForMedia</key>
		<true/>
	</dict>

	<!--
	Background mode "audio" — sin esto, iOS pausa el stream al bloquear
	el iPhone o mandar la app a segundo plano. Lo declaramos aquí como
	array literal porque INFOPLIST_KEY_UIBackgroundModes (build setting)
	no se fusiona correctamente cuando convive con INFOPLIST_FILE.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!--
	Escena CarPlay. Declarada aquí (no vía INFOPLIST_KEY_..._Generation, que
	se desactiva en el pbxproj) por el mismo problema de fusión que
	UIBackgroundModes: cuando la clave existe en ambos sitios, el resultado
	no es fiable. La escena de la app del iPhone no se declara — SwiftUI la
	aporta sola. UIApplicationSupportsMultipleScenes = true es obligatorio
	para que coche y teléfono muestren interfaz A LA VEZ.
	-->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>CarPlay</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
